# Copy of ~/neko-test/Containerfile on the relative's Linux server (rootless podman image neko-test), kept here for history.
# Neko test environment (2026-10-16): the project dependencies + test tools, Linux. Source is mounted at /src
# (read-only, or :O for a throw-away writable overlay). Build with ./sync-and-build.sh so the lock matches the repo.
FROM docker.io/library/python:3.11-slim
RUN apt-get update -q && apt-get install -y -q --no-install-recommends git && rm -rf /var/lib/apt/lists/*
RUN pip install -q uv
# Google Chrome: the node browser launches channel="chrome" (test_browser). Playwright's own installer, the version in
# the lock (playwright 1.63.0 in uv.lock; installed here first so this layer survives dependency changes).
RUN uv pip install -q --system "playwright==1.63.0" && python -m playwright install --with-deps chrome && rm -rf /var/lib/apt/lists/*
# gitleaks (secret scanner): jarvis_kernel.scrub uses it as its second pass; without it 5 kernel tests skip. Checksum pinned.
RUN python -c "import urllib.request as u; u.urlretrieve('https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_linux_x64.tar.gz', '/tmp/gl.tgz')" \
 && echo "551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb  /tmp/gl.tgz" | sha256sum -c - && tar -xzf /tmp/gl.tgz -C /usr/local/bin gitleaks && rm /tmp/gl.tgz && gitleaks version
# Node.js 24 (as on the laptop): upstream's frontend and harness tests run JS through node. Checksum pinned.
RUN python -c "import urllib.request as u; u.urlretrieve('https://nodejs.org/dist/v24.22.0/node-v24.22.0-linux-x64.tar.xz', '/tmp/node.txz')" \
 && echo "cc2f601cee82d9a5a233302fe307abc600727035fd7d2c3a3571755989e95008  /tmp/node.txz" | sha256sum -c - \
 && python -c "import tarfile; tarfile.open('/tmp/node.txz').extractall('/opt', filter='tar')" && rm /tmp/node.txz \
 && ln -s /opt/node-v24.22.0-linux-x64/bin/node /opt/node-v24.22.0-linux-x64/bin/npm /opt/node-v24.22.0-linux-x64/bin/npx /usr/local/bin/ && node --version
# The project's dependencies at the EXACT versions in uv.lock, as the laptop installs them (uv sync --frozen --all-extras
# --group galgame) plus the dev group (pytest, pytest-asyncio, pytest-randomly, pytest-xdist, hypothesis, ruff ...).
# Until 2026-10-16 this compiled pyproject.toml afresh, which drifted from the lock (starlette 1.8.0 instead of 1.3.1)
# and hung three static-file range tests.
COPY pyproject.toml uv.lock /deps/
COPY deps /deps/deps
RUN cd /deps && uv export -q --frozen --no-hashes --no-emit-project --all-extras --group dev --group galgame -o req.txt \
 && uv pip install -q --system -r req.txt
# Outside the lock, as on the laptop: DBOS for Neko missions; kaldi-native-fbank, upstream's test-only oracle;
# python-pptx and pdfplumber for the deliverables/research plugins (pinned in plugin/plugins/deliverables/pyproject.toml).
RUN uv pip install -q --system pytest pytest-asyncio pytest-randomly pytest-xdist \
    "dbos==3.3.0" "kaldi-native-fbank==1.22.3" "python-pptx==1.0.2" "pdfplumber==0.11.10" && which uvx ruff
# The project's own console script (pyproject [project.scripts]); uv sync makes it on the laptop. The code comes from
# /src through PYTHONPATH, like the laptop's editable install.
RUN printf '#!/usr/local/bin/python\nimport sys\nfrom plugin.neko_plugin_cli.cli import main\nsys.exit(main())\n' > /usr/local/bin/neko-plugin \
 && chmod 755 /usr/local/bin/neko-plugin
# As jarvis/scripts/run-upstream-tests.ps1: "uv run --no-sync python" must use this environment, Node prints TAP.
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUTF8=1 PYTHONPATH=/src UV_PROJECT_ENVIRONMENT=/usr/local UV_NO_SYNC=1 NODE_OPTIONS=--test-reporter=tap
WORKDIR /src
