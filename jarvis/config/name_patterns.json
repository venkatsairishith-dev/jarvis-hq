  "translit": {
    "_note": "A small deterministic Telugu / Devanagari to Latin table for a NAME the owner wrote in his own script (ప్రియ -> Priya, लक्ष्मी -> Lakshmi, సతీష్ -> Satish): the canonical English spelling to store, and what the translator gets back. Short vowels only (ా -> a, ీ -> i), no tone marks. It is a guess at the spelling the owner would accept: the native spelling is kept as an alias, and the laptop session checks real names (D70). Devanagari drops the final inherent a (राज -> Raj); Telugu keeps it (సీత -> Sita).",
    "te": {
      "drop_final_a": false,
      "virama": "్",
      "vowels": {"అ": "a", "ఆ": "a", "ఇ": "i", "ఈ": "i", "ఉ": "u", "ఊ": "u", "ఋ": "ru", "ఎ": "e", "ఏ": "e", "ఐ": "ai", "ఒ": "o", "ఓ": "o", "ఔ": "au"},
      "signs": {"ా": "a", "ి": "i", "ీ": "i", "ు": "u", "ూ": "u", "ృ": "ru", "ె": "e", "ే": "e", "ై": "ai", "ొ": "o", "ో": "o", "ౌ": "au"},
      "marks": {"ం": "m", "ః": "h", "ఁ": "n"},
      "consonants": {"క": "k", "ఖ": "kh", "గ": "g", "ఘ": "gh", "ఙ": "ng", "చ": "ch", "ఛ": "chh", "జ": "j", "ఝ": "jh", "ఞ": "ny", "ట": "t", "ఠ": "th", "డ": "d", "ఢ": "dh", "ణ": "n",
                     "త": "t", "థ": "th", "ద": "d", "ధ": "dh", "న": "n", "ప": "p", "ఫ": "ph", "బ": "b", "భ": "bh", "మ": "m", "య": "y", "ర": "r", "ల": "l", "వ": "v", "శ": "sh",
                     "ష": "sh", "స": "s", "హ": "h", "ళ": "l", "ఱ": "r"}
    },
    "hi": {
      "drop_final_a": true,
      "virama": "्",
      "vowels": {"अ": "a", "आ": "a", "इ": "i", "ई": "i", "उ": "u", "ऊ": "u", "ऋ": "ri", "ए": "e", "ऐ": "ai", "ओ": "o", "औ": "au", "ऑ": "o"},
      "signs": {"ा": "a", "ि": "i", "ी": "i", "ु": "u", "ू": "u", "ृ": "ri", "े": "e", "ै": "ai", "ो": "o", "ौ": "au", "ॉ": "o"},
      "marks": {"ं": "n", "ँ": "n", "ः": "h"},
