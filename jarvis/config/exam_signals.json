  "paths": [
    {"rx": "codechef\\.com/start\\d+", "level": "decline", "why": "a contest page"},
    {"rx": "/mod/quiz/(?:attempt|startattempt|processattempt)\\.php", "level": "weak", "weight": 2, "why": "an LMS quiz attempt page"},
    {"rx": "/courses/\\d+/quizzes/\\d+/take", "level": "weak", "weight": 2, "why": "an LMS quiz attempt page"},
    {"rx": "/(?:take|start)[-_]?(?:the[-_]?)?(?:exam|test|assessment)", "level": "weak", "weight": 1, "why": "a page that starts a test"}
  ],
  "text": [
    {"rx": "\\bproctor(?:ed|ing|s)?\\b|\\bremote invigilat\\w*|\\binvigilat(?:ed|ion|or)\\b", "level": "decline", "why": "the page speaks of proctoring"},
    {"rx": "(?:turn|switch) on (?:your )?(?:web ?cam|camera)|\\bweb ?cam (?:must|has to|needs to|is required|access|will be)|\\b(?:allow|enable|grant)(?: access to)? (?:your |the )?(?:web ?cam|camera)\\b[^\\n]{0,40}\\b(?:exam|test|assessment|proctor)|\\bkeep your (?:web ?cam|camera) on\\b|\\bcamera (?:must|has to) (?:remain|stay) on\\b", "level": "decline", "why": "the page asks for the webcam during the test"},
    {"rx": "\\bshare your (?:entire |whole |full )?screen\\b|\\bscreen[- ]?shar(?:e|ing) (?:is |will be )?(?:required|mandatory|must)|\\byou (?:must|have to|need to) share your screen\\b|\\bscreen (?:is being )?recorded\\b|\\bscreen recording (?:is )?(?:required|enabled)\\b", "level": "decline", "why": "the page asks to share or record the screen during the test"},
    {"rx": "\\block ?down browser\\b|\\brespondus\\b|\\bsafe exam browser\\b", "level": "decline", "why": "a lock-down browser is required"},
    {"rx": "\\b(?:tab|window) (?:switching|changes?) (?:is |are |will be )?(?:monitored|recorded|detected|flagged|not allowed)|\\bleaving (?:this|the) (?:tab|page|window|full[- ]?screen) (?:will be|is) (?:flagged|recorded|reported)|\\bdo not (?:leave|switch|exit)(?: from)? (?:this|the) (?:tab|page|window|full[- ]?screen)\\b", "level": "decline", "why": "the page watches for you leaving it during the test"},
    {"rx": "\\bhonou?r code\\b|\\bhonou?r pledge\\b|\\bi (?:will|shall) not (?:give|receive|use) (?:any )?(?:unauthori[sz]ed|outside) (?:aid|help|assistance)|\\bintegrity (?:pledge|agreement|statement|declaration)\\b|\\bby (?:starting|beginning|continuing|clicking)[^\\n]{0,60}\\b(?:exam|test|assessment)\\b[^\\n]{0,60}\\b(?:agree|confirm|certify|affirm)", "level": "ask", "why": "honor-code or integrity-pledge wording"},
    {"rx": "\\b(?:online|timed|proctored|graded|live) (?:assessment|exam|test)\\b|\\bthis (?:exam|test|assessment) is (?:graded|timed|being timed|for credit|counted|mandatory)|\\byour (?:answers|submission)[^\\n]{0,40}\\b(?:will be|are) (?:graded|evaluated|scored|reviewed by (?:the )?(?:recruiter|employer|company|examiner))", "level": "ask", "why": "the page says this is a graded or timed assessment"},
    {"rx": "\\bsubmit (?:the |your )?(?:test|exam|assessment|quiz)\\b|\\bfinal submission\\b|\\bfinish attempt\\b|\\bend (?:the )?(?:test|exam|assessment)\\b|\\bfinish (?:the )?(?:test|exam|assessment)\\b", "level": "weak", "weight": 2, "discountable": false, "why": "a final submit button for a test"},
    {"rx": "\\b(?:time (?:left|remaining)|remaining time|time limit)\\b[^\\n]{0,14}\\d|\\b\\d{1,3}:\\d{2}(?::\\d{2})?\\s*(?:left|remaining|min(?:ute)?s? left)\\b|\\bcountdown\\b", "level": "weak", "weight": 1, "discountable": false, "why": "a countdown"},
    {"rx": "\\b(?:final|mid[- ]?term|end[- ]?sem(?:ester)?|semester|internal|board|entrance|certification) (?:exam|examination|test|assessment)\\b|\\bquiz attempt\\b|\\bexamination hall\\b", "level": "weak", "weight": 1, "why": "an exam banner"},
    {"rx": "\\bacademic (?:integrity|honesty|misconduct)\\b|\\bplagiarism (?:policy|will be)\\b|\\bcheating\\b[^\\n]{0,30}\\b(?:will|may) (?:result|lead)", "level": "weak", "weight": 1, "why": "integrity wording"}
  ],
  "names": [
    {"rx": "(?<![a-z])(?:exam|exams|examination|midterm|mid-term|mid_term|final|finals|assessment|quiz[ _-]?attempt|end[ _-]?sem|endsem)(?![a-z])", "weight": 1, "why": "a file or folder named like an exam or assessment"}
  ],
  "practice": {
    "rx": "\\b(?:practice|practise|practicing|mock|sample|samples|previous[ _-]?years?|past[ _-]?(?:papers?|year)|old[ _-]?papers?|revision|revise|tutorial|exercises?|homework|home[ _-]?work|lab|labs|worksheet|assignment|study|solved|examples?|model[ _-]?papers?|prep|preparation|question[ _-]?bank|problem[ _-]?sets?|syllabus|notes)\\b|(?:^|[ _.-])(?:prep|pyq|pyqs)(?:$|[ _.-])",
