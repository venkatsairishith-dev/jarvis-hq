{
 "_note": "Admin verbs the elevated broker may run on the owner's Windows PC (plan item 1, P4 step 5). PROPOSED: every verb is approved=false, so the broker refuses all of them until the owner approves each line (set approved=true at the console; this file is a safety component, so agents cannot change it). Each verb is a fixed program and argument list; a parameter can only be a validated value in a fixed position, never shell text. params: name -> {type: id|service|text|choice|int|path, ...}. restore_point: create a system restore point first. check: a read-only command whose exit code 0 (and, with check_expect, a match of that pattern in its output) confirms the result. undo: the verb that reverses it, if any. No verb may disable Defender, UAC or the firewall, edit boot settings, create users or touch credentials: jarvis_node/adminctl.py refuses those even if they are added here.",
 "verbs": {
  "winget_install": {"approved": false, "summary": "Install the app {id} from the winget catalogue", "restore_point": true, "undo": "winget_uninstall",
   "params": {"id": {"type": "id"}},
   "argv": ["winget", "install", "--id", "{id}", "--exact", "--source", "winget", "--silent", "--accept-package-agreements", "--accept-source-agreements", "--disable-interactivity"],
   "check": ["winget", "list", "--id", "{id}", "--exact", "--disable-interactivity"], "check_expect": "{id}", "timeout_s": 1800},
  "winget_upgrade": {"approved": false, "summary": "Update the app {id}", "restore_point": true,
   "params": {"id": {"type": "id"}},
   "argv": ["winget", "upgrade", "--id", "{id}", "--exact", "--source", "winget", "--silent", "--accept-package-agreements", "--accept-source-agreements", "--disable-interactivity"],
   "check": ["winget", "list", "--id", "{id}", "--exact", "--disable-interactivity"], "check_expect": "{id}", "timeout_s": 1800},
  "winget_uninstall": {"approved": false, "summary": "Uninstall the app {id}", "restore_point": true, "undo": "winget_install",
   "params": {"id": {"type": "id"}},
   "argv": ["winget", "uninstall", "--id", "{id}", "--exact", "--silent", "--disable-interactivity"], "timeout_s": 900},
  "service_restart": {"approved": false, "summary": "Restart the Windows service {name}",
   "params": {"name": {"type": "service"}},
   "argv": ["powershell.exe", "-NoProfile", "-NonInteractive", "-Command", "Restart-Service", "-Name", "{name}", "-Force"],
   "check": ["sc.exe", "query", "{name}"], "check_expect": "STATE\\s*:\\s*4\\s+RUNNING", "timeout_s": 120},
  "service_start": {"approved": false, "summary": "Start the Windows service {name}", "undo": "service_stop",
   "params": {"name": {"type": "service"}},
   "argv": ["sc.exe", "start", "{name}"], "check": ["sc.exe", "query", "{name}"], "check_expect": "STATE\\s*:\\s*4\\s+RUNNING", "timeout_s": 120},
  "service_stop": {"approved": false, "summary": "Stop the Windows service {name}", "undo": "service_start",
   "params": {"name": {"type": "service"}},
   "argv": ["sc.exe", "stop", "{name}"], "timeout_s": 120},
  "service_startup": {"approved": false, "summary": "Set the Windows service {name} to start {mode}",
   "params": {"name": {"type": "service"}, "mode": {"type": "choice", "values": {"automatic": "auto", "manual": "demand", "disabled": "disabled"}}},
   "argv": ["sc.exe", "config", "{name}", "start=", "{mode}"], "timeout_s": 60},
  "restore_point": {"approved": false, "summary": "Create a restore point called \"{description}\"",
   "params": {"description": {"type": "text", "max": 60}},
   "argv": ["powershell.exe", "-NoProfile", "-NonInteractive", "-Command", "Checkpoint-Computer", "-Description", "{description}", "-RestorePointType", "MODIFY_SETTINGS"],
   "timeout_s": 600},
  "sfc_scan": {"approved": false, "summary": "Check and repair Windows system files (sfc /scannow)", "params": {},
   "argv": ["sfc.exe", "/scannow"], "timeout_s": 3600},
  "dism_restore_health": {"approved": false, "summary": "Repair the Windows component store (DISM RestoreHealth)", "restore_point": true, "params": {},
   "argv": ["DISM.exe", "/Online", "/Cleanup-Image", "/RestoreHealth"], "timeout_s": 7200},
  "defender_scan": {"approved": false, "summary": "Run a {kind} Microsoft Defender scan",
   "params": {"kind": {"type": "choice", "values": {"quick": "QuickScan", "full": "FullScan"}}},
   "argv": ["powershell.exe", "-NoProfile", "-NonInteractive", "-Command", "Start-MpScan", "-ScanType", "{kind}"], "timeout_s": 14400},
  "defender_signature_update": {"approved": false, "summary": "Update Microsoft Defender's virus definitions", "params": {},
   "argv": ["powershell.exe", "-NoProfile", "-NonInteractive", "-Command", "Update-MpSignature"], "timeout_s": 900},
  "defender_exclusion_add": {"approved": false, "summary": "Stop Defender scanning the folder {path} (a build or model folder)", "undo": "defender_exclusion_remove",
   "params": {"path": {"type": "path", "roots": ["D:\\jarvis\\models", "D:\\jarvis\\cache", "D:\\jarvis\\hq-neko\\.venv", "D:\\jarvis\\tools"]}},
   "argv": ["powershell.exe", "-NoProfile", "-NonInteractive", "-Command", "Add-MpPreference", "-ExclusionPath", "{path}"], "timeout_s": 120},
  "defender_exclusion_remove": {"approved": false, "summary": "Let Defender scan the folder {path} again", "undo": "defender_exclusion_add",
   "params": {"path": {"type": "path", "roots": ["D:\\jarvis\\models", "D:\\jarvis\\cache", "D:\\jarvis\\hq-neko\\.venv", "D:\\jarvis\\tools"]}},
   "argv": ["powershell.exe", "-NoProfile", "-NonInteractive", "-Command", "Remove-MpPreference", "-ExclusionPath", "{path}"], "timeout_s": 120},
  "power_plan": {"approved": false, "summary": "Switch the power plan to {plan}",
   "params": {"plan": {"type": "choice", "values": {"balanced": "381b4222-f694-41f0-9685-ff5bb260df2e", "high_performance": "8c5e7fda-e8bf-4a96-9a85-a6e23a8c635c", "power_saver": "a1841308-3541-4fab-bc81-f71556f20b4a"}}},
   "argv": ["powercfg.exe", "/setactive", "{plan}"], "timeout_s": 60},
  "jarvis_task_switch": {"approved": false, "summary": "{action} JARVIS's own scheduled task {task}",
   "params": {"task": {"type": "choice", "values": {"JarvisNekoStack": "JarvisNekoStack", "JarvisNode": "JarvisNode", "JarvisLab": "JarvisLab"}},
              "action": {"type": "choice", "values": {"enable": "/ENABLE", "disable": "/DISABLE"}}},
   "argv": ["schtasks.exe", "/Change", "/TN", "{task}", "{action}"], "timeout_s": 60},
  "jarvis_task_run": {"approved": false, "summary": "Run JARVIS's own scheduled task {task} now",
   "params": {"task": {"type": "choice", "values": {"JarvisNekoStack": "JarvisNekoStack", "JarvisNode": "JarvisNode", "JarvisLab": "JarvisLab"}}},
   "argv": ["schtasks.exe", "/Run", "/TN", "{task}"], "timeout_s": 60},
  "reboot": {"approved": false, "summary": "Restart the PC in {delay_s} seconds (cancel with reboot_cancel)", "undo": "reboot_cancel",
   "params": {"delay_s": {"type": "int", "min": 60, "max": 3600}},
   "argv": ["shutdown.exe", "/r", "/t", "{delay_s}", "/c", "JARVIS restart approved by the owner"], "timeout_s": 30},
  "reboot_cancel": {"approved": false, "summary": "Cancel a pending restart", "params": {},
   "argv": ["shutdown.exe", "/a"], "timeout_s": 30},
  "dns_flush": {"approved": false, "summary": "Clear the DNS cache", "params": {},
   "argv": ["ipconfig.exe", "/flushdns"], "timeout_s": 60},
  "winsock_reset": {"approved": false, "summary": "Reset the network stack (needs a restart afterwards)", "restore_point": true, "params": {},
   "argv": ["netsh.exe", "winsock", "reset"], "timeout_s": 120}
 }
}
