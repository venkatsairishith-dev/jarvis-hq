{
  "_note": "Laptop stack as jarvis-start.ps1 starts it (privacy gateway, local speech, the face's tool server). Not used yet: jarvis-start.ps1 remains the launcher until this is run side by side on a quiet machine. Not included: llama-swap, the Jev verdict model, the JARVIS console and the face window (started by their own scripts).",
  "components": [
    {"name": "privacy-gateway", "argv": ["D:/jarvis/tools/privacy-venv/Scripts/python.exe", "jarvis/privacy/gateway.py", "--port", "48950"],
     "cwd": "D:/jarvis/hq", "bind": {"host": "127.0.0.1", "port": 48950}, "health": {"kind": "tcp", "timeout_s": 60}, "restart": "on-failure"},
    {"name": "local-speech", "argv": ["D:/jarvis/tools/jarvis-venv/Scripts/python.exe", "jarvis/scripts/local_speech_server.py", "--port", "48930"],
     "cwd": "D:/jarvis/hq", "bind": {"host": "127.0.0.1", "port": 48930}, "health": {"kind": "tcp", "timeout_s": 60}, "restart": "on-failure"},
    {"name": "face-tools", "argv": ["D:/jarvis/tools/agent-venv/Scripts/python.exe", "-m", "jarvis.bridge.face_tools"], "cwd": "D:/jarvis/hq",
     "depends_on": ["privacy-gateway", "local-speech"],
     "env": {"JARVIS_DATA_DIR": "D:/jarvis/data", "HF_HUB_DISABLE_TELEMETRY": "1"},
     "bind": {"host": "127.0.0.1", "port": 48970}, "health": {"kind": "tcp", "timeout_s": 120}, "restart": "on-failure"}
  ]
}
