{
  "name": "@jarvis/face",
  "type": "module",
  "version": "0.12.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "description": "JARVIS's face: avatar, chat and voice desktop app (built from Project AIRI v0.12.0, MIT)",
  "author": {
    "name": "JARVIS owner (venkatsairishith-dev)"
  },
  "license": "MIT",
  "scripts": {
    "build:packages": "turbo run build -F \"@proj-airi/stage-tamagotchi^...\"",
    "dev": "pnpm -F @proj-airi/stage-tamagotchi run dev",
    "build": "pnpm run build:packages && pnpm -F @proj-airi/stage-tamagotchi run build",
    "build:win": "pnpm run build:packages && pnpm -F @proj-airi/stage-tamagotchi run build:win",
    "test:run": "vitest run",
    "typecheck": "turbo run typecheck -F @proj-airi/stage-tamagotchi",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@alint-js/cli": "catalog:",
    "@alint-js/plugin-js": "catalog:",
    "@antfu/eslint-config": "catalog:",
    "@arethetypeswrong/core": "catalog:",
    "@electron-toolkit/eslint-config-ts": "catalog:",
    "@iconify/utils": "catalog:",
    "@moeru/eslint-config": "catalog:",
    "@proj-airi/unocss-preset-chromatic": "catalog:",
    "@types/node": "catalog:",
    "@unocss/eslint-config": "catalog:",
    "@unocss/eslint-plugin": "catalog:",
    "@unocss/preset-mini": "catalog:",
    "@unocss/preset-web-fonts": "catalog:",
    "@vitest/browser-playwright": "catalog:vitest",
    "@vitest/coverage-v8": "catalog:vitest",
    "eslint": "catalog:",
    "eslint-plugin-format": "catalog:",
    "eslint-plugin-oxlint": "catalog:",
    "eslint-plugin-perfectionist": "catalog:",
    "eslint-plugin-slop": "catalog:",
    "oxc-minify": "catalog:",
    "oxlint": "catalog:",
    "playwright": "catalog:",
    "publint": "catalog:",
    "rollup": "catalog:",
    "tinyexec": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "uncrypto": "catalog:",
    "unocss": "catalog:",
    "unocss-preset-scrollbar": "catalog:",
    "unplugin-lightningcss": "catalog:",
    "unplugin-raw": "catalog:",
    "unplugin-unused": "catalog:",
    "vite": "catalog:",
    "vite-plugin-inspect": "catalog:",
    "vitest": "catalog:vitest",
    "vitest-browser-vue": "catalog:",
    "yaml": "catalog:"
  },
  "workspaces": [
    "packages/**",
    "plugins/**",
    "integrations/**",
    "services/**",
    "examples/**",
    "engines/**",
    "apps/**",
    "server/**"
  ]
}
