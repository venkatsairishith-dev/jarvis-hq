    {
      "auto_start": false,
      "description": {
        "$i18n": "entry.save_note.description",
        "default": "Save Markdown text as a note in the study vault (summaries, explanations, exercises). Creates a new note; mode=append adds to an existing one. Never overwrites. Use folders such as notes/, summaries/ or exercises/."
      },
      "event_key": "learn_vault.save_note",
      "event_type": "plugin_entry",
      "id": "save_note",
      "input_schema": {
        "properties": {
          "content": {
            "description": "Markdown text.",
            "type": "string"
          },
          "mode": {
            "default": "create",
            "enum": [
              "create",
              "append"
            ],
            "type": "string"
          },
          "path": {
            "description": "Path inside the vault, e.g. exercises/cell-biology.md",
            "type": "string"
          }
        },
        "required": [
          "path",
          "content"
        ],
        "type": "object"
      },
      "kind": "action",
      "llm_result_fields": [
        "path",
        "mode",
        "bytes"
      ],
      "llm_result_schema": {
        "properties": {
          "bytes": {},
          "mode": {},
          "path": {}
        },
        "required": [
          "path",
          "mode",
          "bytes"
        ],
        "type": "object"
      },
      "metadata": {},
      "model_validate": true,
      "name": {
        "$i18n": "entry.save_note.name",
        "default": "Save a study note"
      },
      "return_message": "",
      "timeout": 30
    },
    {
      "auto_start": false,
      "description": {
        "$i18n": "entry.search_notes.description",
        "default": "Search the study vault for a few words; returns the best matching notes with a snippet."
      },
      "event_key": "learn_vault.search_notes",
      "event_type": "plugin_entry",
      "id": "search_notes",
      "input_schema": {
        "properties": {
