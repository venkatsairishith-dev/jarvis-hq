{
  "build_env": {
    "arch": "x86_64",
    "os": "linux",
    "python": "3.11"
  },
  "entries": [
    {
      "auto_start": false,
      "description": {
        "$i18n": "entry.answer_input.description",
        "default": "The owner's answer to the question a held task asked (from the chat box). Validated against the question; the task then resumes from its checkpoint. Owner only."
      },
      "event_key": "main_agent.answer_input",
      "event_type": "plugin_entry",
      "id": "answer_input",
      "input_schema": {
        "properties": {
          "request_id": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          },
          "values": {
            "type": "object"
          }
        },
        "required": [
          "run_id",
          "request_id",
          "values"
        ],
        "type": "object"
      },
      "kind": "action",
      "llm_result_fields": [
        "state",
        "message"
      ],
      "llm_result_schema": {
        "properties": {
          "message": {},
          "state": {}
        },
        "required": [
          "state",
          "message"
        ],
        "type": "object"
      },
      "metadata": {},
      "model_validate": true,
      "name": {
        "$i18n": "entry.answer_input.name",
        "default": "Answer a waiting question"
      },
      "return_message": "",
      "timeout": 60
    },
    {
      "auto_start": false,
      "description": {
        "$i18n": "entry.cancel_input.description",
        "default": "Drop the question a held task asked; that task ends as cancelled. Owner only."
      },
      "event_key": "main_agent.cancel_input",
      "event_type": "plugin_entry",
      "id": "cancel_input",
      "input_schema": {
        "properties": {
          "request_id": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "request_id"
        ],
        "type": "object"
      },
      "kind": "action",
      "llm_result_fields": [
        "state",
        "message"
      ],
      "llm_result_schema": {
        "properties": {
          "message": {},
          "state": {}
        },
        "required": [
          "state",
          "message"
        ],
        "type": "object"
      },
      "metadata": {},
      "model_validate": true,
      "name": {
        "$i18n": "entry.cancel_input.name",
        "default": "Cancel a waiting question"
      },
      "return_message": "",
      "timeout": 20
    },
    {
      "auto_start": false,
      "description": {
        "$i18n": "entry.forget_learning.description",
        "default": "Erase the episode log and its salt. Owner only (a panel button with a confirmation)."
      },
      "event_key": "main_agent.forget_learning",
      "event_type": "plugin_entry",
      "id": "forget_learning",
      "input_schema": {
        "properties": {},
        "type": "object"
      },
      "kind": "action",
      "llm_result_fields": [
        "state",
        "forgotten"
      ],
      "llm_result_schema": {
        "properties": {
          "forgotten": {},
          "state": {}
        },
        "required": [
          "state",
          "forgotten"
        ],
        "type": "object"
      },
      "metadata": {},
      "model_validate": true,
      "name": {
        "$i18n": "entry.forget_learning.name",
        "default": "Forget everything learned from use"
      },
      "return_message": "",
      "timeout": 10
    },
    {
      "auto_start": false,
      "description": {
        "$i18n": "entry.learning_stats.description",
        "default": "Success rate overall and per plan shape and helper, the commonest error classes, whether the latest tasks do better than the ones before, and the helpers that fail more than they work. Counts and classes only: no task text is ever stored."
      },
      "event_key": "main_agent.learning_stats",
      "event_type": "plugin_entry",
      "id": "learning_stats",
      "input_schema": {
        "properties": {},
        "type": "object"
      },
      "kind": "action",
      "llm_result_fields": [
        "episodes",
        "success_rate",
        "trend"
      ],
      "llm_result_schema": {
        "properties": {
          "episodes": {},
          "success_rate": {},
          "trend": {}
        },
        "required": [
          "episodes",
          "success_rate",
          "trend"
        ],
        "type": "object"
      },
      "metadata": {},
      "model_validate": true,
      "name": {
        "$i18n": "entry.learning_stats.name",
        "default": "What the main agent has learned from use"
      },
      "return_message": "",
      "timeout": 10
    },
    {
      "auto_start": false,
      "description": {
        "$i18n": "entry.pending_inputs.description",
        "default": "The questions held tasks are waiting on: the question and its fields (never any answer or secret)."
      },
      "event_key": "main_agent.pending_inputs",
      "event_type": "plugin_entry",
      "id": "pending_inputs",
      "input_schema": {
        "properties": {},
        "type": "object"
      },
      "kind": "action",
      "llm_result_fields": [
        "count"
      ],
      "llm_result_schema": {
        "properties": {
          "count": {}
        },
        "required": [
          "count"
        ],
        "type": "object"
      },
      "metadata": {},
      "model_validate": true,
      "name": {
        "$i18n": "entry.pending_inputs.name",
        "default": "Questions waiting for the owner"
      },
      "return_message": "",
      "timeout": 10
    },
    {
      "auto_start": false,
      "description": {
        "$i18n": "entry.plan_task.description",
        "default": "Show how the main agent would split a task across its helpers, without running anything."
      },
      "event_key": "main_agent.plan_task",
      "event_type": "plugin_entry",
      "id": "plan_task",
      "input_schema": {
        "properties": {
          "mode": {
            "default": "work",
            "description": "chat (no tools), work (tools), code (JARVIS lab agents in the bound project), learn (study vault and documents).",
            "enum": [
              "chat",
              "work",
              "code",
              "learn"
            ],
            "type": "string"
          },
          "task": {
            "description": "The task, in the user's words.",
            "type": "string"
          }
        },
        "required": [
          "task"
        ],
        "type": "object"
      },
      "kind": "action",
      "llm_result_fields": [
        "summary",
        "steps",
        "mode"
      ],
      "llm_result_schema": {
        "properties": {
          "mode": {},
          "steps": {},
          "summary": {}
        },
        "required": [
          "summary",
          "steps",
          "mode"
        ],
        "type": "object"
      },
      "metadata": {},
      "model_validate": true,
      "name": {
        "$i18n": "entry.plan_task.name",
        "default": "Plan a task (preview)"
      },
      "return_message": "",
      "timeout": 300
    },
    {
      "auto_start": false,
      "description": {
        "$i18n": "entry.resume_run.description",
        "default": "Continue a task that was interrupted (the app stopped) or held back. Finished steps are kept. A step whose result is unknown is NOT run again unless its id is listed in rerun, which the user must confirm."
      },
      "event_key": "main_agent.resume_run",
      "event_type": "plugin_entry",
      "id": "resume_run",
      "input_schema": {
        "properties": {
          "rerun": {
            "description": "Step ids to run again, only after the user confirms they did not happen.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "run_id": {
            "description": "The run to resume (latest resumable if empty).",
            "type": "string"
          }
        },
        "type": "object"
      },
      "kind": "action",
      "llm_result_fields": [
        "run_id",
        "message"
      ],
      "llm_result_schema": {
        "properties": {
          "message": {},
          "run_id": {}
        },
        "required": [
          "run_id",
          "message"
        ],
        "type": "object"
      },
      "metadata": {},
      "model_validate": true,
      "name": {
        "$i18n": "entry.resume_run.name",
        "default": "Resume an interrupted task"
      },
      "return_message": "",
      "timeout": 60
    },
    {
      "auto_start": false,
      "description": {
        "$i18n": "entry.run_status.description",
        "default": "Show what the main agent is doing or did last: each step, its outcome and whether it can be resumed."
      },
      "event_key": "main_agent.run_status",
      "event_type": "plugin_entry",
      "id": "run_status",
      "input_schema": {
        "properties": {
          "run_id": {
            "description": "Optional run id; latest if empty.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "kind": "action",
      "llm_result_fields": [
        "run_id",
        "state",
        "steps"
      ],
      "llm_result_schema": {
        "properties": {
          "run_id": {},
          "state": {},
          "steps": {}
        },
        "required": [
          "run_id",
          "state",
          "steps"
        ],
        "type": "object"
      },
      "metadata": {},
      "model_validate": true,
      "name": {
        "$i18n": "entry.run_status.name",
        "default": "Main agent status"
      },
      "return_message": "",
      "timeout": 10
    },
    {
      "auto_start": false,
      "description": {
        "$i18n": "entry.run_task.description",
        "default": "Do a real task that needs several steps or different kinds of help: research then write something up, look something up on the web and act on it, work with files or code on the PC, or combine tools. The main agent plans it, picks the helpers that fit (reasoning, installed plugins, the web browser, JARVIS and its sub-agents), runs independent steps in parallel and reports back. Use this instead of a single tool when more than one step or tool is involved. Not for chit-chat or one quick question."
      },
      "event_key": "main_agent.run_task",
      "event_type": "plugin_entry",
      "id": "run_task",
      "input_schema": {
        "properties": {
          "mode": {
            "default": "work",
            "description": "chat (no tools), work (tools), code (JARVIS lab agents in the bound project), learn (study vault and documents).",
            "enum": [
              "chat",
              "work",
              "code",
              "learn"
            ],
            "type": "string"
          },
          "source": {
            "description": "Leave empty. 'widget' is set by the desktop widget, which does not wait for the plan.",
            "enum": [
              "chat",
              "widget"
            ],
            "type": "string"
          },
          "task": {
            "description": "The task, in the user's own words with their details.",
            "type": "string"
          }
        },
        "required": [
          "task"
        ],
        "type": "object"
      },
      "kind": "action",
      "llm_result_fields": [
        "run_id",
        "message",
        "steps",
        "mode",
        "state"
      ],
      "llm_result_schema": {
        "properties": {
          "message": {},
          "mode": {},
          "run_id": {},
          "state": {},
          "steps": {}
        },
        "required": [
          "run_id",
          "message",
          "steps",
          "mode",
          "state"
        ],
        "type": "object"
      },
      "metadata": {},
      "model_validate": true,
      "name": {
        "$i18n": "entry.run_task.name",
        "default": "Do a task with the right helpers"
      },
      "return_message": "",
      "timeout": 300
    },
    {
      "auto_start": false,
      "description": {
        "$i18n": "entry.stop_task.description",
        "default": "Stop the task the main agent is planning or running: no further step starts, and the step in progress is asked to stop. Steps already finished stay finished. This stops this one task only; it is not JARVIS's Stop all or kill switch."
      },
      "event_key": "main_agent.stop_task",
      "event_type": "plugin_entry",
      "id": "stop_task",
      "input_schema": {
        "properties": {},
        "type": "object"
      },
      "kind": "action",
      "llm_result_fields": [
        "requested",
        "stopped",
        "still_running",
        "message"
      ],
      "llm_result_schema": {
        "properties": {
          "message": {},
          "requested": {},
          "still_running": {},
          "stopped": {}
        },
        "required": [
          "requested",
          "stopped",
          "still_running",
          "message"
        ],
        "type": "object"
      },
      "metadata": {},
      "model_validate": true,
      "name": {
        "$i18n": "entry.stop_task.name",
        "default": "Stop the current task"
      },
      "return_message": "",
      "timeout": 20
    }
  ],
  "entries_config_sha256": "",
