    {
      "auto_start": false,
      "description": {
        "$i18n": "entry.make_presentation.description",
        "default": "Create a polished, animated PowerPoint deck (.pptx) from a structured outline, check it (text fit, schema, rendering) and optionally open it or start the slideshow. Slides: list of {layout, title, subtitle, bullets, notes, sources}. layout: title, section, bullets, two_column (left_title, left, right_title, right), chart (chart: {type: column|bar|line|pie, title, labels, series: [{name, values}], caption, unit}), table (table: {columns, rows, caption}), quote (quote, attribution), timeline (items: [{label, text}]), stats (items: [{label: '42%', text}]), closing. Cite with [S1] markers that match sources: [{id: 'S1', title, url, date, publisher}]."
      },
      "event_key": "deliverables.make_presentation",
      "event_type": "plugin_entry",
      "id": "make_presentation",
      "input_schema": {
        "properties": {
          "open_after": {
            "default": false,
            "type": "boolean"
          },
          "spec": {
            "description": "title, subtitle, author, topic, theme (auto if empty: midnight, paper, vivid), animate, sources, slides.",
            "type": "object"
          },
          "start_show": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "spec"
        ],
        "type": "object"
      },
      "kind": "action",
      "llm_result_fields": [
        "file",
        "slides",
        "qa"
      ],
      "llm_result_schema": {
        "properties": {
          "file": {},
          "qa": {},
          "slides": {}
        },
        "required": [
          "file",
          "slides",
          "qa"
        ],
        "type": "object"
      },
      "metadata": {},
      "model_validate": true,
      "name": {
        "$i18n": "entry.make_presentation.name",
        "default": "Make a presentation"
      },
      "return_message": "",
      "timeout": 600
    },
    {
      "auto_start": false,
      "description": {
        "$i18n": "entry.make_report.description",
        "default": "Create a professional PDF report (cover, contents, sections, tables, charts, references, page numbers, clickable links), check it and optionally open it. Sections: [{heading, level 2|3, kind: fact|opinion|uncertain|recommendation, paragraphs, bullets, callout, table, chart}]. Cite with [S1] markers matching sources."
