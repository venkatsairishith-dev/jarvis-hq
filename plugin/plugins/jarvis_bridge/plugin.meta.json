{
  "build_env": {
    "arch": "x86_64",
    "os": "linux",
    "python": "3.11"
  },
  "entries": [
    {
      "auto_start": false,
      "description": {
        "$i18n": "entry.cancel_task.description",
        "default": "Cancel one command this bridge handed to JARVIS, by its command_id: JARVIS stops waiting for its answer and the lab tasks that command started are stopped too (with their queued or running jobs). Other commands' tasks are not touched. This is not the kill switch."
      },
      "event_key": "jarvis_bridge.cancel_task",
      "event_type": "plugin_entry",
      "id": "cancel_task",
      "input_schema": {
        "properties": {
          "command_id": {
            "description": "The command_id returned by delegate_task.",
            "type": "string"
          }
        },
        "required": [
          "command_id"
        ],
        "type": "object"
      },
      "kind": "action",
      "llm_result_fields": [
        "command_id",
        "cancelled",
        "tasks_stopped",
        "message"
      ],
      "llm_result_schema": {
        "properties": {
          "cancelled": {},
          "command_id": {},
          "message": {},
          "tasks_stopped": {}
        },
        "required": [
          "command_id",
          "cancelled",
          "tasks_stopped",
          "message"
        ],
        "type": "object"
      },
      "metadata": {},
      "model_validate": true,
      "name": {
        "$i18n": "entry.cancel_task.name",
        "default": "Cancel a task handed to JARVIS"
      },
      "return_message": "",
      "timeout": 20
    },
    {
      "auto_start": false,
      "description": {
        "$i18n": "entry.connector_overview.description",
        "default": "Read-only: the external services JARVIS is connected to and whether each is working. No endpoints or credentials are shown."
      },
      "event_key": "jarvis_bridge.connector_overview",
      "event_type": "plugin_entry",
      "id": "connector_overview",
      "input_schema": {
        "properties": {},
        "type": "object"
      },
      "kind": "action",
      "llm_result_fields": [
        "connectors"
      ],
      "llm_result_schema": {
        "properties": {
          "connectors": {}
        },
        "required": [
          "connectors"
        ],
        "type": "object"
      },
      "metadata": {},
      "model_validate": true,
      "name": {
        "$i18n": "entry.connector_overview.name",
        "default": "JARVIS connectors"
      },
      "return_message": "",
      "timeout": 20
    },
    {
      "auto_start": false,
      "description": {
        "$i18n": "entry.delegate_task.description",
        "default": "Hand a real task to JARVIS, the owner's main agent. Use it for work that needs planning, several steps or specialist helpers: research, writing or fixing code, working with files, using apps or the browser, or anything the user asks to 'get done'. JARVIS plans it, picks the right sub-agents and tools, asks the user for approval where needed and verifies the result. Do not use it for small talk or simple questions."
      },
      "event_key": "jarvis_bridge.delegate_task",
      "event_type": "plugin_entry",
      "id": "delegate_task",
      "input_schema": {
        "properties": {
          "task": {
            "description": {
              "$i18n": "entry.delegate_task.param.task",
              "default": "The task, in the user's own words, with any details they gave (at most 2000 characters)."
            },
            "type": "string"
          }
        },
        "required": [
          "task"
        ],
        "type": "object"
      },
      "kind": "action",
      "llm_result_fields": [
        "command_id",
        "state",
        "message"
      ],
      "llm_result_schema": {
        "properties": {
          "command_id": {},
          "message": {},
          "state": {}
        },
        "required": [
          "command_id",
          "state",
          "message"
        ],
        "type": "object"
      },
      "metadata": {},
      "model_validate": true,
      "name": {
        "$i18n": "entry.delegate_task.name",
        "default": "Hand a task to JARVIS"
      },
      "return_message": "",
      "timeout": 20
    },
    {
      "auto_start": false,
      "description": {
        "$i18n": "entry.jarvis_status.description",
        "default": "Check that the JARVIS console and kernel are reachable and not busy or switched off."
      },
      "event_key": "jarvis_bridge.jarvis_status",
      "event_type": "plugin_entry",
      "id": "jarvis_status",
      "input_schema": {
        "properties": {},
        "type": "object"
      },
      "kind": "action",
      "llm_result_fields": [
        "ready",
        "message"
      ],
      "llm_result_schema": {
        "properties": {
          "message": {},
          "ready": {}
        },
        "required": [
          "ready",
          "message"
        ],
        "type": "object"
      },
      "metadata": {},
      "model_validate": true,
      "name": {
        "$i18n": "entry.jarvis_status.name",
        "default": "Is JARVIS ready?"
      },
      "return_message": "",
      "timeout": 20
    },
    {
      "auto_start": false,
      "description": {
        "$i18n": "entry.pending_approvals.description",
        "default": "Read-only: how many actions JARVIS is waiting for the owner to approve, and what they are. Approving or denying is done in the JARVIS console with the owner's PIN, never from here."
      },
      "event_key": "jarvis_bridge.pending_approvals",
      "event_type": "plugin_entry",
      "id": "pending_approvals",
      "input_schema": {
        "properties": {},
        "type": "object"
      },
      "kind": "action",
      "llm_result_fields": [
        "count",
        "approvals"
      ],
      "llm_result_schema": {
        "properties": {
          "approvals": {},
          "count": {}
        },
        "required": [
          "count",
          "approvals"
        ],
        "type": "object"
      },
      "metadata": {},
      "model_validate": true,
      "name": {
        "$i18n": "entry.pending_approvals.name",
        "default": "JARVIS approvals waiting"
      },
      "return_message": "",
      "timeout": 20
    },
    {
      "auto_start": false,
      "description": {
        "$i18n": "entry.task_result.description",
        "default": "Check whether a task handed to JARVIS is still running, finished or failed. Leave command_id empty for the latest one."
      },
      "event_key": "jarvis_bridge.task_result",
      "event_type": "plugin_entry",
      "id": "task_result",
      "input_schema": {
        "properties": {
          "command_id": {
            "description": {
              "$i18n": "entry.task_result.param.command_id",
              "default": "The command_id returned by delegate_task (optional)."
            },
            "type": "string"
          }
        },
        "type": "object"
      },
      "kind": "action",
      "llm_result_fields": [
        "command_id",
        "state",
        "message",
        "reply"
      ],
      "llm_result_schema": {
        "properties": {
          "command_id": {},
          "message": {},
          "reply": {},
          "state": {}
        },
        "required": [
          "command_id",
          "state",
          "message",
          "reply"
        ],
        "type": "object"
      },
      "metadata": {},
      "model_validate": true,
      "name": {
        "$i18n": "entry.task_result.name",
        "default": "Check a JARVIS task"
      },
      "return_message": "",
      "timeout": 20
    }
  ],
  "entries_config_sha256": "",
