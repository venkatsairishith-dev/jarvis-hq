[Unit]
Description=Hermes Agent dashboard (browser UI + desktop-app backend; Tailscale address only, username/password with hashed password)
After=network-online.target tailscaled.service jarvis-hermes-gateway.service
Wants=network-online.target

[Service]
User=jarvis-agent
Group=jarvis-agent
WorkingDirectory=/home/jarvis-agent
Environment=HOME=/home/jarvis-agent
Environment=HERMES_HOME=/home/jarvis-agent/.hermes
Environment=HTTPS_PROXY=http://100.125.91.51:4750
Environment=HTTP_PROXY=http://100.125.91.51:4750
Environment=NO_PROXY=127.0.0.1,localhost
EnvironmentFile=/home/jarvis-agent/.hermes/.env
ExecStart=/home/jarvis-agent/venv314/bin/hermes dashboard --no-open --host 100.125.91.51 --port 9119
Restart=on-failure
RestartSec=10
# exit 78 = another Hermes backend already holds this HERMES_HOME; restarting cannot help
RestartPreventExitStatus=78
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/jarvis-agent
PrivateTmp=true
MemoryMax=2G

[Install]
WantedBy=multi-user.target
